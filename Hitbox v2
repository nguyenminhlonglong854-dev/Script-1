local hitboxOn = false
local hitboxSize = 10
local boxes = {}

--// Tìm NPC/TrainingTarget
local function createBox(model)
	if model:IsA("Model") and model.Name == "TrainingTarget" then
		local root = model:FindFirstChild("HumanoidRootPart")
		if root and not boxes[model] then
			local box = Instance.new("BoxHandleAdornment")
			box.Name = "AnimeRainbowHitbox"
			box.Adornee = root
			box.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
			box.Transparency = 1
			box.AlwaysOnTop = true
			box.ZIndex = 10
			box.Parent = root

			boxes[model] = box
		end
	end
end

local function removeBoxes()
	for model, box in pairs(boxes) do
		if box then box:Destroy() end
		boxes[model] = nil
	end
end

--// Toggle
toggle.MouseButton1Click:Connect(function()
	hitboxOn = not hitboxOn
	toggle.Text = hitboxOn and "HITBOX : ON" or "HITBOX : OFF"

	if not hitboxOn then
		removeBoxes()
	else
		for _, obj in ipairs(workspace:GetDescendants()) do
